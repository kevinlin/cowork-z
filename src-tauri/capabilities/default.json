{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "skills"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }, { "path": "/media/**" }, { "path": "/mnt/**" }]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:webview:allow-create-webview-window"
  ]
}

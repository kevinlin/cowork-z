{
  "identifier": "skills-manager",
  "windows": ["skills"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "opener:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
    "dialog:default",
    "dialog:allow-open"
  ]
}

{
  "identifier": "skills-manager",
  "windows": ["skills"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }, { "path": "/media/**" }, { "path": "/mnt/**" }]
    },
    "dialog:default",
    "dialog:allow-open"
  ]
}

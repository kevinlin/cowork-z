{
  "name": "sidecar-opencode",
  "version": "0.4.0",
  "description": "OpenCode server sidecar for Cowork-Z",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:binary": "pnpm build && pkg dist/index.js --targets node20-macos-arm64 --output ../binaries/sidecar-opencode-aarch64-apple-darwin",
    "build:binary:x64": "pnpm build && pkg dist/index.js --targets node20-macos-x64 --output ../binaries/sidecar-opencode-x86_64-apple-darwin",
    "build:binary:win": "pnpm build && pkg dist/index.js --targets node20-win-x64 --output ../binaries/sidecar-opencode-x86_64-pc-windows-msvc.exe",
    "build:binary:linux": "pnpm build && pkg dist/index.js --targets node20-linux-x64 --output ../binaries/sidecar-opencode-x86_64-unknown-linux-gnu",
    "build:binary:linux-arm64": "pnpm build && pkg dist/index.js --targets node20-linux-arm64 --output ../binaries/sidecar-opencode-aarch64-unknown-linux-gnu"
  },
  "dependencies": {
    "eventsource": "^2.0.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/eventsource": "^1.1.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.0",
    "@yao-pkg/pkg": "5.16.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}

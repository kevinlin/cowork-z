{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cowork-z",
  "version": "0.5.0",
  "identifier": "com.kevinlin.cowork-z",
  "build": {
    "beforeDevCommand": "cd src-tauri/sidecar-opencode && pnpm install && cd ../.. && node scripts/build-sidecar.mjs && pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cowork-Z",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sidecar-opencode"
    ],
    "resources": ["resources/skills/**/*"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "dialog": null,
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1ODBCMzdFMUVDRDYxRTUKUldUbFljMGVmck9BZGVpTlVSSHRHcEdMQjVaek1SbFFQNXhMTlRkNjg4TDNuNENLM3VaK3RXU2kK",
      "endpoints": [
        "https://github.com/kevinlin/cowork-z/releases/latest/download/latest.json"
      ]
    }
  }
}